# Copy to `.env.local` (gitignored). Read only on the server (BFF routes),
# never shipped to the browser.

# The platform's API gateway. Local dev = the gateway on :8080.
GATEWAY_URL=http://localhost:8080

# httpOnly cookie that holds the platform JWT.
SESSION_COOKIE=att_session

# Public base URL of the console - used to build the Microsoft redirect URI.
APP_URL=http://localhost:3000

# "Sign in with Microsoft 365" (optional). Register an app in Entra ID with a
# Web redirect URI of <APP_URL>/api/auth/microsoft/callback and a client secret,
# then fill these in. Leave blank to hide the Microsoft button and run local
# email sign-in only. auth-service must also get ENTRA_ISSUER_URI + ENTRA_CLIENT_ID
# (see infra/compose/.env.example) so it can validate the returned token.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Optional override; defaults to <APP_URL>/api/auth/microsoft/callback
AZURE_AD_REDIRECT_URI=

# Demo persona switcher. When "true", the account menu offers the seeded logins
# (tech / POC / HR / employee / admin) so every role's view can be shown without
# typing passwords. Each option performs a REAL login as that seeded account and
# swaps the session cookie - it is not impersonation, and the backend has no
# "act as" path. Leave unset anywhere that holds real data.
DEMO_LOGINS_ENABLED=
# Password for those seeded accounts; only read when the switcher is on.
DEMO_PASSWORD=
