### asset-tracker — manual API walkthrough (IntelliJ HTTP Client / VS Code REST Client)
#
# Start the stack first:  cd ../compose && docker compose up -d
# Then run these top to bottom. {{host}} comes from http-client.env.json (select "local").
# Requests capture values (token, ids) into variables for the ones that follow.

@client = 1

### Clients (public)
GET {{host}}/api/clients

### Assets for client 1 (public)  ->  capture an in-stock asset id
GET {{host}}/api/assets?clientId={{client}}&status=IN_STOCK

> {%
  client.test("has stock", () => client.assert(response.body.length >= 1));
  client.global.set("assetId", response.body[0].id);
%}

### All laptops (public)
GET {{host}}/api/assets?clientId={{client}}&type=Laptop

### People for client 1 (public)  ->  capture a person id
GET {{host}}/api/people?clientId={{client}}

> {% client.global.set("personId", response.body[0].id); %}

### Desks (public)
GET {{host}}/api/locations?clientId={{client}}&kind=DESK

### --- writes need a token ---

### Check out with no token -> 401
POST {{host}}/api/assignments
Content-Type: application/json

{ "clientId": {{client}}, "assetId": {{assetId}}, "holderType": "PERSON", "holderId": {{personId}} }

> {% client.test("401", () => client.assert(response.status === 401)); %}

### Sign in as the seeded tech  ->  capture token
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "tech@acme.example", "password": "Passw0rd!" }

> {%
  client.test("got a token", () => client.assert(response.body.token));
  client.global.set("token", response.body.token);
%}

### Check the asset out to the person
POST {{host}}/api/assignments
Authorization: Bearer {{token}}
Content-Type: application/json

{ "clientId": {{client}}, "assetId": {{assetId}}, "holderType": "PERSON", "holderId": {{personId}} }

> {%
  client.test("open assignment", () => client.assert(response.body.open === true));
  client.test("actor is the tech", () =>
    client.assert(response.body.checkedOutBy === "tech@acme.example"));
%}

### It now shows on the person
GET {{host}}/api/assets?clientId={{client}}&holderType=PERSON&holderId={{personId}}

### Check it out again -> 409 (already assigned)
POST {{host}}/api/assignments
Authorization: Bearer {{token}}
Content-Type: application/json

{ "clientId": {{client}}, "assetId": {{assetId}}, "holderType": "PERSON", "holderId": {{personId}} }

> {% client.test("409", () => client.assert(response.status === 409)); %}

### Offboard the person -> collects everything back
POST {{host}}/api/assignments/offboard?clientId={{client}}&personId={{personId}}
Authorization: Bearer {{token}}

> {% client.test("something returned", () => client.assert(response.body.returned.length >= 1)); %}

### Asset is back in stock
GET {{host}}/api/assets/{{assetId}}

> {% client.test("IN_STOCK", () => client.assert(response.body.status === "IN_STOCK")); %}

### Notifications for this client (public)
GET {{host}}/api/notifications?clientId={{client}}
