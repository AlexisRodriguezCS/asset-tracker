# Copy to `.env` (gitignored) and fill in real values.
#   cd infra/compose && cp .env.example .env
# Docker Compose loads infra/compose/.env automatically.

# --- Local auth (RS256). auth-service generates its signing key pair at startup
#     and publishes the public half at /.well-known/jwks.json; the gateway reads
#     it from JWT_JWKS_URI. No shared secret.
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=asset-tracker-auth
JWT_JWKS_URI=http://auth-service:8081/.well-known/jwks.json

# --- Web console origin allowed through CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- "Sign in with Microsoft 365" (optional). Leave BLANK to run with no Azure
#     dependency. Fill in after registering an app in Entra ID (see RUNBOOK).
#     ISSUER_URI: https://login.microsoftonline.com/<tenant-id>/v2.0
#     CLIENT_ID:  the Entra app's Application (client) ID
#     The gateway accepts Entra tokens directly; auth-service also validates the
#     id-token from the console's OIDC callback and issues a local session token.
ENTRA_ISSUER_URI=
ENTRA_CLIENT_ID=
# Client (tenant) ids granted to a first-seen Microsoft user (demo default: all).
ENTRA_DEFAULT_CLIENT_IDS=1,2,3

# --- PostgreSQL overlay (docker-compose.postgres.yml) ---
POSTGRES_USER=att
POSTGRES_PASSWORD=att-dev-password
