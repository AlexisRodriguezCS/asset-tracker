# Copy to `.env` (gitignored) and fill in real values.
#   cd infra/compose && cp .env.example .env
# Docker Compose loads infra/compose/.env automatically.

# --- Local auth (HS256). MUST be >= 32 bytes. Generate a fresh one:
#     openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-hex-string-0000000000000000000000
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=asset-tracker-auth

# --- Web console origin allowed through CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- "Sign in with Microsoft" (optional). Leave BLANK to run with no Azure
#     dependency. Fill in after registering an app in Entra ID (see RUNBOOK).
ENTRA_ISSUER_URI=
ENTRA_CLIENT_ID=

# --- PostgreSQL overlay (docker-compose.postgres.yml) ---
POSTGRES_USER=att
POSTGRES_PASSWORD=att-dev-password
